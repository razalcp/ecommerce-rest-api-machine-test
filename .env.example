NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
CORS_ORIGIN=*
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# Optional: required only when running `npm run seed:admin`.
# Replace the example password with a strong password of at least 16 characters
# and no more than 72 UTF-8 bytes.
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=admin@gmail.com
ADMIN_SEED_PASSWORD=admin@123
