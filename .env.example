NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce-rest-api
CORS_ORIGIN=*
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# Optional: required only when running `npm run seed:admin`.
# Replace the example email and password before running the seed command.
# The password must be at least 5 characters and no more than 72 UTF-8 bytes.
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=admin@gmail.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
